<!-- product/editProductForm.fxml -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.grocerystore.controller.EditProductFormController"
      spacing="10" stylesheets="@../css/theme.css" style="-fx-padding:20;">
    <Label text="Редактирование продукта" style="-fx-font-size:18; -fx-font-weight:bold;"/>
    <HBox spacing="10"><Label text="Название:"/><TextField fx:id="tfName"/></HBox>
    <HBox spacing="10"><Label text="Цена:"/><TextField fx:id="tfPrice"/></HBox>
    <HBox spacing="10"><Label text="Количество:"/><TextField fx:id="tfQuantity"/></HBox>
    <HBox spacing="10"><Label text="В наличии:"/><TextField fx:id="tfStock"/></HBox>
    <HBox spacing="10">
        <Button text="Изменить" onAction="#goEdit"/>
        <Button text="Главная" onAction="#goToMainForm"/>
    </HBox>
</VBox>
