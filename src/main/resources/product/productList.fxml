<!-- product/productList.fxml -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.grocerystore.controller.ProductListController"
      spacing="10" stylesheets="@../css/theme.css" style="-fx-padding:10;">
    <TableView fx:id="tvProduct" prefHeight="350" prefWidth="600">
        <columns>
            <TableColumn fx:id="tcId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="tcName" text="Название продукта" prefWidth="150"/>
            <TableColumn fx:id="tcPrice" text="Цена" prefWidth="80"/>
            <TableColumn fx:id="tcQuantity" text="Кол-во" prefWidth="80"/>
            <TableColumn fx:id="tcStock" text="В наличии" prefWidth="80"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button text="Редактировать" onAction="#editSelectedProduct"/>
        <Button fx:id="deleteProductButton" text="Удалить" onAction="#deleteSelectedProduct"/>
        <Button text="Главная" onAction="#goToMainForm"/>
    </HBox>
</VBox>
