<!-- customer/editCustomerForm.fxml -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.grocerystore.controller.EditCustomerFormController"
      spacing="10" alignment="CENTER" stylesheets="@../css/theme.css" style="-fx-padding:20;">
    <Label text="Редактирование покупателя" style="-fx-font-size:18; -fx-font-weight:bold;"/>
    <Label text="Имя:"/>
    <TextField fx:id="firstnameField"/>
    <Label text="Фамилия:"/>
    <TextField fx:id="lastnameField"/>
    <Label text="Логин:"/>
    <TextField fx:id="usernameField"/>
    <Label text="Баланс:"/>
    <TextField fx:id="balanceField"/>
    <Button text="Сохранить изменения" onAction="#saveCustomer"/>
    <Button text="Отменить" onAction="#cancelEdit"/>
</VBox>
