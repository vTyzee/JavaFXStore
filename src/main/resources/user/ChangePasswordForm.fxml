<!-- user/changePasswordForm.fxml -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.grocerystore.controller.ChangePasswordController"
      spacing="10" stylesheets="@../css/theme.css" style="-fx-padding:20;">
    <Label text="Смена пароля" style="-fx-font-size:18;"/>
    <ComboBox fx:id="cbUsers" promptText="Выберите пользователя"/>
    <TextField fx:id="tfUserId" promptText="Логин" visible="false"/>
    <PasswordField fx:id="pfNewPassword" promptText="Новый пароль"/>
    <Button text="Изменить" onAction="#handleChangePassword"/>
    <Label fx:id="lblResult"/>
    <Button text="Главная" onAction="#goToMainForm"/>
</VBox>
