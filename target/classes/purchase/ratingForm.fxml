<!-- purchase/ratingForm.fxml -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.grocerystore.controller.RatingFormController"
      spacing="10" stylesheets="@../css/theme.css" style="-fx-padding:20;">
    <Label text="Рейтинг продаваемости продуктов" style="-fx-font-size:18;"/>
    <ComboBox fx:id="cbPeriodType"/>
    <TextField fx:id="tfPeriodValue" promptText="Введите год/месяц/неделю"/>
    <Button text="Посчитать" onAction="#handleCalculateRating"/>
    <Button text="Главная" onAction="#goToMainForm"/>
    <TableView fx:id="tvRating" prefWidth="600" prefHeight="300">
        <columns>
            <TableColumn fx:id="tcProduct" text="Продукт" prefWidth="300"/>
            <TableColumn fx:id="tcTotalSold" text="Продано, шт." prefWidth="300"/>
        </columns>
    </TableView>
</VBox>
