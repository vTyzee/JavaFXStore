<!-- purchase/incomeForm.fxml -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.grocerystore.controller.IncomeFormController"
      spacing="10" stylesheets="@../css/theme.css" style="-fx-padding:20;">
    <Label text="Доход магазина" style="-fx-font-size:18;"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Начало (yyyy-MM-dd):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="tfStartDate" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Конец (yyyy-MM-dd):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="tfEndDate" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>
    <Button text="Посчитать доход" onAction="#handleCalculateIncome"/>
    <Button text="Главная" onAction="#goToMainForm"/>
    <Label fx:id="lblIncomeResult"/>
</VBox>
