<!-- chat/chatForm.fxml -->
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.grocerystore.controller.ChatFormController"
      spacing="8" stylesheets="css/theme.css" style="-fx-padding:10;">
    <Label fx:id="lblNickname"/>
    <TextArea fx:id="taChat" prefHeight="300" editable="false" wrapText="true"/>
    <HBox spacing="5">
        <TextField fx:id="tfMessage" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnSend" text="Отправить"/>
    </HBox>
    <Button fx:id="btnClose" text="Закрыть чат" onAction="#closeChat"/>
</VBox>
